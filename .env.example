# Copy this file to ".env" and fill in your real values, then `npm start`.
# The .env file is gitignored so your secrets never get committed.
# Everything is optional — with nothing set, the app runs in demo mode
# (messages and emails are logged instead of actually sent).

# ─────────────────────────────────────────────────────────────
# Reminders — Exotel (SMS + WhatsApp)
# ─────────────────────────────────────────────────────────────
NOTIFY_CHANNEL=exotel
EXOTEL_MODE=both                       # both = every reminder over SMS AND WhatsApp
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=                            # your Exotel account SID
EXOTEL_SUBDOMAIN=api.in.exotel.com     # Mumbai region; use api.exotel.com for Singapore
EXOTEL_FROM=                           # your ExoPhone / Sender ID (SMS) and WhatsApp number
# NOTE: Indian DLT rules require the SMS + WhatsApp reminder text to be
# pre-registered as approved templates on your Exotel account first.

# ─────────────────────────────────────────────────────────────
# Email the completed document packet — Google Workspace SMTP
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourcompany.com          # a Google Workspace mailbox that sends the packet
SMTP_PASS=                             # a Google "App Password" (NOT your normal login password)
MAIL_FROM=UPSY Loan Agent <you@yourcompany.com>
OPS_EMAIL=loans@yourcompany.com        # the single inbox that receives completed packets
# How to get SMTP_PASS: Google Account → Security → 2-Step Verification (must be ON)
# → App passwords → generate one for "Mail". Paste that 16-char code here.

# ─────────────────────────────────────────────────────────────
# Browser voice calls (the /m mobile page's "Call UPSY" button)
# ─────────────────────────────────────────────────────────────
# Two providers. Nothing here is needed for live-assist (AgentCall) — that is a
# separate, unrelated feature.
#
#   upsy     — our own relay (backend/voiceRelay.js): Deepgram → Claude → Cartesia
#              Sonic, with turn-taking on this server. Speaks Hindi, keeps the
#              prompt in git, cannot be switched off by a vendor's free-tier
#              policy. Audio DOES pass through this server. Run `npm run voice:relay`.
#   cartesia — the hosted agent. Unusable on a free account today: Cartesia has
#              paused agent deployments, so every call fails preflight.
VOICE_PROVIDER=upsy

# ── VOICE_PROVIDER=upsy ──────────────────────────────────────
DEEPGRAM_API_KEY=                      # streaming STT + endpointing. $200 free credit ≈ 45,000 minutes
CARTESIA_API_KEY=                      # sk_car_… from play.cartesia.ai — TTS only on this path; NEVER ship to a browser
# ANTHROPIC_API_KEY is the brain (Claude Haiku 4.5); OPENROUTER_API_KEY is the
# fallback. One of the two is required — see the AI section above.
# CARTESIA_VOICE_ID=f8f5f1b2-…         # defaults to Kiara, Indian-accented English female.
#                                      # A US voice reading "lakh"/"Aadhaar" is harder to follow.
#                                      # `GET /voices` lists the rest.
# CARTESIA_TTS_MODEL=sonic-2           # sonic-english is sunsetted and returns HTTP 400
# VOICE_SENTENCE_PAUSE_MS=280          # pause inserted between sentences. Cartesia's own speed
#                                      # controls are INERT on sonic-2 (measured across numeric
#                                      # values, nested shapes and two API versions: 197-222 wpm,
#                                      # all noise), so pacing is fixed here. 0 disables.
# VOICE_PACE_EXTRA_MS=0                # OFF, and leave it off. Inserting silence into the gaps
#                                      # between words looked right on paper (~220 wpm -> ~166) but
#                                      # stutters mid-word in practice: chunks arrive ~130ms long
#                                      # and the detector cannot tell a gap between words from a
#                                      # quiet moment inside one. See backend/voicePacing.js.
# VOICE_BARGE_IN_MIN_WORDS=2           # recognised words needed to interrupt the agent. At 1 the
#                                      # agent's own echoed voice on speakerphone cuts itself off.
# ANTHROPIC_VOICE_MODEL=claude-haiku-4-5
# VOICE_RELAY_MODE=agent               # "echo" bounces the caller's own audio back: proves
#                                      # the transport with no AI in the path at all
# VOICE_MAX_CALL_MS=600000             # hard cap per call, so a stuck socket cannot bill overnight
# DEEPGRAM_ENDPOINTING_MS=800          # trailing silence that ends a turn. Higher = feels slow,
#                                      # lower = cuts people off mid-sentence. NOT Deepgram's
#                                      # default of 300 — at 300 a two-sentence question gets
#                                      # answered after the first sentence. Re-tune on real callers.
# DEEPGRAM_LANGUAGE=en-IN              # NOT plain "en": that hears "fifteen lakh rupees" as
#                                      # "15 locker piece". Measured, not superstition.
# DEEPGRAM_KEYTERMS=lakh,crore,EMI,…   # comma-separated vocabulary boost; defaults to the loan terms

# ── VOICE_PROVIDER=cartesia (hosted, currently blocked) ──────
CARTESIA_AGENT_ID=                     # the agent's id from the Cartesia dashboard
# CARTESIA_VERSION=2025-04-16          # pinned API version; bump only after reading their changelog
# ⚠️ Creating the agent is not enough — you must press Publish/Deploy on it, and
# free accounts currently cannot. An undeployed agent accepts the WebSocket and
# then closes it with a bare "1011 Internal server error", which names nothing
# and looks like a bug on our side. `npm run voice:check` reports the real state.

OPS_PHONE=                             # where "Schedule call" requests are texted; unset = server console only

# ─────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────
# APP_URL=https://your-deployed-url    # used in WhatsApp/SMS reply links (defaults to localhost)
# PORT=3000
