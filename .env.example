# Copy this file to ".env" and fill in your real values, then `npm start`.
# The .env file is gitignored so your secrets never get committed.
# Everything is optional — with nothing set, the app runs in demo mode
# (messages and emails are logged instead of actually sent).

# ─────────────────────────────────────────────────────────────
# Reminders — Exotel (SMS + WhatsApp)
# ─────────────────────────────────────────────────────────────
NOTIFY_CHANNEL=exotel
EXOTEL_MODE=both                       # both = every reminder over SMS AND WhatsApp
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=                            # your Exotel account SID
EXOTEL_SUBDOMAIN=api.in.exotel.com     # Mumbai region; use api.exotel.com for Singapore
EXOTEL_FROM=                           # your ExoPhone / Sender ID (SMS) and WhatsApp number
# NOTE: Indian DLT rules require the SMS + WhatsApp reminder text to be
# pre-registered as approved templates on your Exotel account first.

# ─────────────────────────────────────────────────────────────
# Email the completed document packet — Google Workspace SMTP
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourcompany.com          # a Google Workspace mailbox that sends the packet
SMTP_PASS=                             # a Google "App Password" (NOT your normal login password)
MAIL_FROM=UPSY Loan Agent <you@yourcompany.com>
OPS_EMAIL=loans@yourcompany.com        # the single inbox that receives completed packets
# How to get SMTP_PASS: Google Account → Security → 2-Step Verification (must be ON)
# → App passwords → generate one for "Mail". Paste that 16-char code here.
# MAIL_TEST=1                          # send through a throwaway Ethereal inbox instead of real SMTP.
#                                      # The server logs a preview URL per email. No account needed —
#                                      # this is how the packet email was proved end-to-end.

# ─────────────────────────────────────────────────────────────
# AI — the brain behind every model call in this repo
# ─────────────────────────────────────────────────────────────
# One rule, applied everywhere (voice brain, transcript extractor, course
# verifier, document vision, intake, Ask UPSY, lender drafts, the Meet agent):
# Claude first when ANTHROPIC_API_KEY is set, the OpenAI-compatible side
# otherwise, and a mid-call fallback to the other one when the preferred fails.
# Switching sides is an edit to this file and nothing else — no code changes.
# backend/llmProviders.js is where that decision lives. Placeholder values
# containing "your_" or "_here" are treated as absent, not as a key.
#
# At least ONE of the first two is required. With neither, document reading
# falls back to local OCR and every other AI feature reports itself as off.
ANTHROPIC_API_KEY=                     # platform.claude.com — a developer account, NOT a claude.ai
                                       # subscription. Set a console spend limit before you buy credits.
                                       # This is also the only path that reads PDFs.
OPENROUTER_API_KEY=                    # openrouter.ai — the fallback, and the cheap way to A/B models
# OPENAI_API_KEY=                      # used only when OPENROUTER_API_KEY is absent; the "openai/"
#                                      # model-name prefix is stripped automatically
# ANTHROPIC_VISION_MODEL=claude-opus-4-8      # reads PAN/Aadhaar/ITR/payslips
# OPENROUTER_VISION_MODEL=openai/gpt-4o-mini  # ...and the fallback for the same job. Known to misread
#                                             # digits non-deterministically — see the README's Phase 0.
# OPENROUTER_LIVE_ASSIST_MODEL=        # lets the live-assist call agent use a stronger vision model
#                                      # without changing what reads documents. Falls back to the above.

# Is the course a caller named actually real? (backend/instituteVerify.js)
SERPER_API_KEY=                        # google.serper.dev, free tier 2,500 queries. Without it the
                                       # check falls back to DuckDuckGo's keyless endpoint, which has
                                       # already answered with a bot-check (HTTP 202) from a dev
                                       # machine — treat this key as the real path. Every search
                                       # failure is silence, never a false accusation against a caller.
# VERIFY_SEARCH_TIMEOUT_MS=6000        # the whole check runs off the voice path; nothing awaits it
# VERIFY_JUDGE_TIMEOUT_MS=12000

# Live-call assistance on a real Google Meet / Zoom / Teams call
AGENTCALL_API_KEY=                     # agentcall.io. Unrelated to the /upsy-voice-agent browser
                                       # calls below — this is the bot that joins a meeting and
                                       # watches a shared screen.

# ─────────────────────────────────────────────────────────────
# Browser voice calls (the /upsy-voice-agent mobile page's "Call UPSY" button)
# ─────────────────────────────────────────────────────────────
# Two providers. Nothing here is needed for live-assist (AgentCall) — that is a
# separate, unrelated feature.
#
#   upsy     — our own relay (backend/voiceRelay.js): Deepgram → Claude → Deepgram
#              Aura, with turn-taking on this server. Speaks Hindi, keeps the
#              prompt in git, cannot be switched off by a vendor's free-tier
#              policy. Audio DOES pass through this server. Run `npm run voice:relay`.
#
# "cartesia", the hosted agent, was removed on 2026-08-22 — it could not be
# deployed on a free account, and it was never a real backup (it replaced the
# whole call, not one engine). The backup is STT_PROVIDER/TTS_PROVIDER below.
VOICE_PROVIDER=upsy

# ── VOICE_PROVIDER=upsy ──────────────────────────────────────
DEEPGRAM_API_KEY=                      # does BOTH the hearing (STT) and the speaking (Aura TTS).
                                       # $200 free credit ≈ 45,000 STT minutes or ~7,000 calls of TTS.
# TTS_PROVIDER=deepgram                # "sarvam" moves ENGLISH onto Sarvam too. ⭐ THIS IS THE BACKUP:
#                                      # set it with STT_PROVIDER=sarvam and the whole call leaves
#                                      # Deepgram with no code change. One key does both hearing and
#                                      # speaking, so a Deepgram outage takes out both halves.
# DEEPGRAM_TTS_MODEL=aura-2-athena-en  # "calm, smooth, professional", 195 wpm. Picked by LISTENING.
#                                      # aura-2-vesta-en is 137 wpm if "too fast" ever comes back.
#                                      # Avoid anything sold as energetic/cheerful — wrong register
#                                      # for someone anxious about borrowing fifteen lakh.
# TTS_SPEAK_TIMEOUT_MS=10000           # ceiling per sentence. Without one, a stalled socket hangs the
#                                      # shared speech queue and the agent goes silent for the call.
# The brain and its fallback are set in the AI section above; ANTHROPIC_VOICE_MODEL
# below picks which Claude model answers on a call specifically.
# VOICE_SENTENCE_PAUSE_MS=280          # pause inserted between sentences. Cartesia's speed
#                                      # controls are INERT on sonic-2 (measured across numeric
#                                      # values, nested shapes and two API versions: 197-222 wpm,
#                                      # all noise), so pacing is fixed here. 0 disables.
# VOICE_PACE_EXTRA_MS=0                # OFF, and leave it off. Inserting silence into the gaps
#                                      # between words looked right on paper (~220 wpm -> ~166) but
#                                      # stutters mid-word in practice: chunks arrive ~130ms long
#                                      # and the detector cannot tell a gap between words from a
#                                      # quiet moment inside one. See backend/voicePacing.js.
# VOICE_BARGE_IN_MIN_WORDS=2           # recognised words needed to interrupt the agent. At 1 the
#                                      # agent's own echoed voice on speakerphone cuts itself off.
# ANTHROPIC_VOICE_MODEL=claude-haiku-4-5
# VOICE_RELAY_MODE=agent               # "echo" bounces the caller's own audio back: proves
#                                      # the transport with no AI in the path at all
# VOICE_MAX_CALL_MS=600000             # hard cap per call, so a stuck socket cannot bill overnight
# VOICE_EXTRACT_EVERY_TURNS=6          # how often a live call is read into the caller's branch file
#                                      # while it is still running, in caller turns. Every call is
#                                      # read at teardown regardless; this only decides whether an
#                                      # officer watching /team sees the branches fill in during a
#                                      # long call or all at once at the end. 0 = teardown only.
#                                      # Safe inside a call because nothing awaits it — see
#                                      # captureFacts() in backend/voiceRelay.js.
# ANTHROPIC_EXTRACT_MODEL=claude-haiku-4-5    # which model reads a transcript into branches
# OPENROUTER_EXTRACT_MODEL=openai/gpt-4o-mini # ...and the fallback when no Anthropic key is set
# DEEPGRAM_ENDPOINTING_MS=800          # trailing silence that ends a turn. Higher = feels slow,
#                                      # lower = cuts people off mid-sentence. NOT Deepgram's
#                                      # default of 300 — at 300 a two-sentence question gets
#                                      # answered after the first sentence. Re-tune on real callers.
# DEEPGRAM_LANGUAGE=en-IN              # NOT plain "en": that hears "fifteen lakh rupees" as
#                                      # "15 locker piece". Measured, not superstition.
# DEEPGRAM_KEYTERMS=lakh,crore,EMI,…   # comma-separated vocabulary boost; defaults to the loan terms

# ── Indian languages (Sarvam) ────────────────────────────────
# Hindi, Marathi, Telugu, Tamil, Kannada, Malayalam, Bengali, Gujarati, Punjabi,
# Odia — and English, when detection resolves to it.
#
# NOT optional for these languages, and not a preference: Deepgram Aura has zero
# Indian-language voices, so without this key a non-English call cannot be
# SPOKEN at all. Deepgram still carries English by default and keeps every
# measurement tuned against it.
#
# Run `npm run voice:sarvam` after setting this. It synthesises a caller in
# Hindi, Marathi and Telugu, plays each one back into the recogniser, and
# asserts the language is identified — no key means the check says so and stops.
SARVAM_API_KEY=                        # from dashboard.sarvam.ai. New accounts get Rs 100 of credit,
                                       # which is hours of speech — enough to prove the whole path.
                                       # STT is Rs 30/hour, TTS Rs 30 per 10k characters.
# STT_PROVIDER=auto                    # auto = Deepgram for English, Sarvam for everything else and
                                       # for language=auto. "sarvam" forces one recogniser for every
                                       # language (the honest way to A/B them); "deepgram" pins the
                                       # old behaviour and makes non-English fail loudly.
# SARVAM_TTS_SPEAKER=priya             # ⚠️ NOT CHOSEN BY LISTENING. bulbul:v3 has 39 speakers and
                                       # this repo has picked a voice from a catalogue twice and been
                                       # wrong twice. `npm run voice:sarvam` writes samples to
                                       # data/voice-samples/ — listen before a caller does.
# SARVAM_TTS_PACE=1.0                  # 0.5-2.0, and unlike Cartesia's sonic-2 this one WORKS. The
                                       # English voices run 195-222 wpm against a 140-160 norm, so
                                       # this is the lever — but MEASURE the speaker first.
# SARVAM_SILENCE_MS=800                # Sarvam's equivalent of DEEPGRAM_ENDPOINTING_MS. Same number
                                       # carried across, but a DIFFERENT mechanism (Sarvam runs its
                                       # own VAD), so it is a starting point, not a measurement.
                                       # People pause differently in Marathi than in English.
# SARVAM_STREAM_TYPE=fast              # fast | balanced | simulated. "fast" because partials here
                                       # exist to trigger barge-in, not to be read.
# SARVAM_TTS_SAMPLE_RATE=24000         # what bulbul is asked for; resampled to 44100 for the browser.
                                       # Sarvam documents 44100 for bulbul:v3 "via the REST API" and
                                       # is unclear about the websocket — if voice:sarvam reports 44100
                                       # coming back clean, set it and the resampler drops out.
# SARVAM_STT_MODEL=saaras:v3-realtime  # the streaming model. The batch ones cannot drive a live call.
# SARVAM_VAD_THRESHOLD=0.3             # 0.0-1.0 VAD sensitivity
# SARVAM_MIN_SPEECH_MS=250             # shortest thing treated as speech rather than noise
#
# When a language=auto call is allowed to SWITCH mid-call. All three gates must
# pass. Deliberately conservative, because the failure modes are not symmetric:
# one extra English turn is a small annoyance, while the voice swapping back and
# forth is what a caller reports as "it kept changing" — and real callers here
# are code-mixed ("mujhe fifteen lakh ka loan chahiye" is one sentence, two
# languages), so single detections genuinely disagree. Loosen against real logs.
# VOICE_LANG_MIN_CONFIDENCE=0.75       # below this the detection is a guess
# VOICE_LANG_MIN_WORDS=3               # "haan" is not evidence of a language
# VOICE_LANG_MIN_AGREEING=2            # consecutive finals that must agree

# ── Team dashboard sign-in ───────────────────────────────────
# BOTH must be set, or /team and every /api/applications route stay OPEN to
# anyone with the URL. The boot log says which state it is in, loudly.
#
# NEVER put the password itself in a file git can see - this repo is public.
# Generate the hash instead:  npm run team:hash -- "<password>"
TEAM_EMAIL=                            # the address officers sign in with
TEAM_PASSWORD_HASH=                    # scrypt$salt$hash, from the command above
# TEAM_SESSION_TTL_MS=43200000         # 12h. How long a sign-in lasts.
# TEAM_MAX_ATTEMPTS=8                  # failed sign-ins per IP before a cooldown
# TEAM_ATTEMPT_WINDOW_MS=900000        # ...and how long that window is

# ── Reminder timings ─────────────────────────────────────────
# Real values by default (24h / 48h). Lower them for a demo if you must, but
# the server REFUSES TO START if NOTIFY_CHANNEL sends real messages while
# these are under an hour - that combination messages every paused applicant
# on the demo cycle, from a DLT-registered sender, with no way to recall it.
# STALE_AFTER_MS=86400000              # untouched this long = stalled
# NUDGE_COOLDOWN_MS=172800000          # ...and this long before nudging again
# LOG_PII=1                            # unmask names/PAN/Aadhaar in logs. LOCAL DEBUGGING ONLY.
# SHUTDOWN_GRACE_MS=8000               # how long a live call gets on SIGTERM

# -- Storage -------------------------------------------------
# Absent: the four JSON files in data/, which is how this has always run and is
# still fine for a single instance you do not mind losing on a deploy.
#
# Set: Postgres. Needed for two things the files cannot do at all - surviving a
# deploy (so a caller who rings back on Thursday is still known), and being read
# by more than one process (so the voice agent and the upsy.in app can share a
# database instead of each holding its own copy in memory).
#
# Use Supabase's SESSION pooler, port 6543. The transaction pooler cannot hold a
# session across statements, which breaks every transaction - and transactions
# were the point of moving off files.
#
# Then: npm run db:migrate   (idempotent; leaves data/*.json untouched)
DATABASE_URL=
# DATABASE_POOL_MAX=10                 # held connections. 10 is generous at ~100 users.
